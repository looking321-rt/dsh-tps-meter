{
  "name": "dsh-tps-meter",
  "version": "0.1.3",
  "description": "DeepSeek Harness Web 悬浮窗：实时显示会话输出吞吐（tok/s）、本步/累计 token 与首 token 延迟，支持实时/均速双口径与多会话切换。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tokens-per-second",
    "tok/s",
    "throughput",
    "widget",
    "usage-meter"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "preview": "node test/preview.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "looking321-rt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looking321-rt/dsh-tps-meter.git"
  },
  "homepage": "https://github.com/looking321-rt/dsh-tps-meter#readme",
